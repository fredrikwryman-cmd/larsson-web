---
import Carousel from '../Carousel.astro';
import { prose, images } from '../../lib/content';
import { PAGE_PATHS, withBase, type Lang } from '../../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = prose('svenskt-tenn', lang);
const photos = images('svenskt-tenn');

const heading = t[0].lines[0];
const moreLabel = t[1].lines[0];

/**
 * The live page puts these four photographs in a Flickity carousel and then
 * prints all the text underneath, so nothing tells a reader which credit
 * belongs to which picture. The carousel shape is preserved; the pairing is the
 * fix. Slide 4 genuinely has no credit line in the source, so it carries none.
 */
const slides = [
  { file: photos[0].file, caption: t[2].lines.join(' ') },
  { file: photos[1].file, caption: t[3].lines.join(' ') },
  { file: photos[2].file, caption: t[4].lines.join(' ') },
  { file: photos[3].file },
];

const history = t[5].lines.join(' ');
const backLabel = t[6].lines[0];
---

<div class="wrap">
  <h1>{heading}</h1>
  <p>
    <a
      href="https://www.svenskttenn.se/sv/sortiment/mobler/fatoljer/fatolj-311/100206/"
      rel="noopener">{moreLabel}</a
    >
  </p>

  {/*
    A slide is the full width of the carousel viewport, which is the page
    column less the 6px of padding the viewport keeps on each side for the
    focus ring. The column is 1146px once the wrap reaches its 1206px
    max-width, and 100vw - 60px below that, so a slide is 1134px and
    100vw - 72px. The old value, 788px, was measured against the narrow
    820px wrap this page no longer uses; left as it was it would have asked
    for a 900px rendition to fill 1134px.
  */}
  <Carousel
    slides={slides}
    label={heading}
    sizes="(min-width: 1206px) 1134px, calc(100vw - 72px)"
    lang={lang}
  />

  <p class="st-history">{history}</p>

  <p><a href={withBase(PAGE_PATHS.commissions[lang])}>{backLabel}</a></p>
</div>

<style>
  /* The page column is the site's full 1146px now, the same as /nm-040/ and
     /akes/. Those two set their text in one half of a two-column grid, which
     gives it a measure; this page has no second column, so the paragraph
     carries its own — the same 62ch /uppdrag/ uses for `.others`. Without it
     this one paragraph would run about 150 characters to the line. */
  .st-history {
    margin-block: var(--space-5);
    max-width: 62ch;
  }
</style>
