---
import Figure from './Figure.astro';
import type { Lang } from '../i18n/config';
import { t } from '../i18n/ui';

interface Slide {
  /** Harvested image filename. */
  file: string;
  /** Verbatim credit line from the source page. Some images have none. */
  caption?: string;
}

interface Props {
  slides: Slide[];
  /** Accessible name for the whole carousel. */
  label: string;
  sizes: string;
  lang: Lang;
}

const { slides, label, sizes, lang } = Astro.props;
const s = t(lang);
---

{/*
  Vanilla scroll-snap carousel. No Flickity.

  The live site uses Flickity here: four slides, drag-to-snap, arrows hidden,
  four dots. This reproduces that shape with CSS scroll-snap and ~40 lines of
  JS, and fixes what the original could not do — it is keyboard operable.

  With JavaScript off this is simply a horizontally scrollable row: the track
  is a real overflow container with `tabindex="0"`, so it scrolls by drag, by
  trackpad and by arrow key natively. The dots and the live counter stay
  `hidden` until the script un-hides them, because without JS they could not
  do anything and an inert control is worse than no control.
*/}
<div class="carousel" data-carousel>
  {/*
    The scroll container is a wrapper, NOT the <ul>. Putting role="group" on
    the list itself strips its list semantics and orphans every <li>
    (Lighthouse: "listitem"). The list stays a list; the div does the
    scrolling, holds the label and takes focus.
  */}
  <div
    class="carousel__viewport"
    tabindex="0"
    role="group"
    aria-label={label}
    aria-describedby="carousel-help"
  >
  <ul class="carousel__track">
    {
      slides.map((sl, i) => (
        <li class="carousel__slide" data-slide-index={i}>
          <figure>
            <Figure file={sl.file} variant="content" sizes={sizes} lightbox loading={i === 0 ? 'eager' : 'lazy'} lang={lang} />
            {sl.caption && <figcaption>{sl.caption}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>
  </div>

  <p id="carousel-help" class="visually-hidden">
    {s.carouselHelp}
  </p>

  <div class="carousel__controls" hidden>
    <ul class="carousel__dots">
      {
        slides.map((_, i) => (
          <li>
            <button type="button" class="carousel__dot" data-goto={i} aria-label={s.carouselImage(i + 1, slides.length)}>
              <span aria-hidden="true" />
            </button>
          </li>
        ))
      }
    </ul>
    <p class="carousel__status" aria-live="polite" />
  </div>
</div>

<style>
  .carousel {
    margin-bottom: var(--space-5);
  }

  /* The scrolling element. A flex scroll container's overflowing items still
     leaked into the document's scrollable area — a real wheel gesture scrolled
     the whole page 600px sideways even though body.scrollWidth was correct.
     `contain: paint` is what actually stops that; declaring both overflow axes
     alone did not. Verified: documentElement.scrollWidth 3072 -> 1440 at 1440. */
  .carousel__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    contain: paint;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    /* Room for the focus ring, which overflow would otherwise clip. */
    padding: 6px;
  }

  .carousel__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-4);
  }

  .carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    min-width: 0;
  }

  .carousel__slide figure {
    margin: 0;
  }

  .carousel__slide figcaption {
    margin-top: var(--space-2);
    font-size: var(--fs-nav);
  }

  .carousel__controls[hidden] {
    display: none;
  }

  .carousel__dots {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
  }

  .carousel__dot {
    border: 0;
    background: none;
    padding: var(--space-2);
    cursor: pointer;
    line-height: 0;
  }

  .carousel__dot span {
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1px solid var(--color-link);
  }

  .carousel__dot[aria-current='true'] span {
    background: var(--color-link);
  }

  .carousel__status {
    text-align: center;
    margin: var(--space-2) 0 0;
    font-size: var(--fs-form);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__viewport {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const viewport = root.querySelector<HTMLElement>('.carousel__viewport');
    const controls = root.querySelector<HTMLElement>('.carousel__controls');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.carousel__dot'));
    const status = root.querySelector<HTMLElement>('.carousel__status');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.carousel__slide'));
    if (!viewport || !controls || slides.length < 2) continue;

    // Only now do the dots become useful, so only now are they shown.
    controls.hidden = false;

    let index = 0;

    const sync = (i: number) => {
      index = Math.max(0, Math.min(slides.length - 1, i));
      dots.forEach((d, n) => d.setAttribute('aria-current', String(n === index)));
      if (status) status.textContent = `${index + 1} / ${slides.length}`;
    };

    const goto = (i: number) => {
      const clamped = Math.max(0, Math.min(slides.length - 1, i));
      slides[clamped].scrollIntoView({ block: 'nearest', inline: 'center' });
      sync(clamped);
    };

    dots.forEach((d) =>
      d.addEventListener('click', () => goto(Number(d.dataset.goto)))
    );

    // Arrow keys move one slide when focus is inside the track. Without this
    // the browser scrolls by a fixed step and lands between slides.
    viewport.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        goto(index + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goto(index - 1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        goto(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        goto(slides.length - 1);
      }
    });

    // Keep the dots honest when the user drags or trackpad-scrolls instead.
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.intersectionRatio > 0.6) {
            sync(Number((entry.target as HTMLElement).dataset.slideIndex));
          }
        }
      },
      { root: viewport, threshold: [0.6] }
    );
    slides.forEach((s) => io.observe(s));

    sync(0);
  }
</script>
