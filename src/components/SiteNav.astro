---
/**
 * Navigation.
 *
 * The live site shows a hamburger at EVERY width from 320 to 1920px and has no
 * desktop menu at all, so a visitor who never opens it never learns that
 * Reparationer or Produkter exist. From 851px — the site's one real breakpoint
 * — the six links are now written out in the site's own type with a thin rule
 * beneath. Below 851px the hamburger overlay is unchanged.
 *
 * What is NOT preserved from the original is its accessibility: there the
 * trigger and both close buttons are non-focusable <div>/<span> elements with
 * no tabindex, role or ARIA, so a keyboard user cannot open the navigation at
 * all. Here everything is a real <button>/<a>, focus is trapped while open,
 * Escape closes, and focus returns to the trigger.
 */
import { company } from '../data/company';
import { NAV_KEYS, PAGE_PATHS, withBase, otherLang, type Lang, type PageKey } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Path of this same page in the other language, site-relative. */
  altPath: string;
}

const { lang, altPath } = Astro.props;
const s = t(lang);
const current = Astro.url.pathname;

const items = NAV_KEYS.map((key: PageKey) => ({
  href: withBase(PAGE_PATHS[key][lang]),
  label: s.nav[key as keyof typeof s.nav],
}));

const other = otherLang(lang);
const otherLabel = other === 'sv' ? s.svenska : s.english;
---

{/* Desktop navigation — from 851px only. */}
<nav class="desknav" aria-label={s.mainMenu}>
  <ul>
    {
      items.map((item) => (
        <li>
          <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<p class="langswitch">
  <a href={withBase(altPath)} hreflang={other} lang={other}>{otherLabel}</a>
</p>

<button
  type="button"
  class="nav-toggle"
  id="nav-toggle"
  aria-expanded="false"
  aria-controls="site-menu"
>
  <span class="nav-toggle__bars" aria-hidden="true"></span>
  <span class="visually-hidden">{s.openMenu}</span>
</button>

<div class="site-menu" id="site-menu" hidden>
  <div class="site-menu__inner">
    <button type="button" class="site-menu__close" id="nav-close">
      <span aria-hidden="true">×</span>
      <span class="visually-hidden">{s.closeMenu}</span>
    </button>

    <nav aria-label={s.mainMenu}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="site-menu__contact">
      <a href={company.phone.href}>{company.phone.display}</a><br />
      <a href={`mailto:${company.email}`}>{company.email}</a><br />
      <a href={withBase(altPath)} hreflang={other} lang={other}>{otherLabel}</a>
    </p>
  </div>
</div>

<style>
  /* --- desktop navigation, 851px and up ------------------------------------ */
  .desknav {
    display: none;
  }

  .langswitch {
    display: none;
  }

  @media (min-width: 851px) {
    .desknav {
      display: block;
      grid-area: desknav;
      margin-top: var(--space-5);
      padding-top: var(--space-3);
      border-top: 1px solid var(--color-text);
    }

    .desknav ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-3) var(--space-5);
    }

    .desknav a {
      font-size: var(--fs-nav);
      line-height: 1.6;
    }

    .desknav [aria-current='page'] {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }

    .langswitch {
      display: block;
      grid-area: lang;
      justify-self: end;
      align-self: end;
      margin: 0;
      font-size: var(--fs-form);
    }
  }

  /* --- hamburger, unchanged below 851px ------------------------------------ */
  .nav-toggle {
    grid-area: nav;
    justify-self: end;
    width: 45px;
    height: 40px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  /* The hamburger and its overlay are a small-screen affordance only. This
     block must come AFTER the rule above: same specificity, so source order
     decides, and putting it earlier let `display: grid` win at every width. */
  @media (min-width: 851px) {
    .nav-toggle {
      display: none;
    }
  }

  .nav-toggle__bars,
  .nav-toggle__bars::before {
    display: block;
    width: 28px;
    height: 2px;
    background: var(--color-link);
    content: '';
  }

  .nav-toggle__bars::before {
    transform: translateY(-7px);
  }

  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--color-bg);
    opacity: 0;
    transition: opacity 530ms cubic-bezier(0.19, 1, 0.22, 1);
  }

  .site-menu.is-open {
    opacity: 1;
  }

  .site-menu[hidden] {
    display: none;
  }

  .site-menu__inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    padding: var(--space-4);
  }

  .site-menu__close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 45px;
    height: 40px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: var(--fs-menu);
    line-height: 1;
    color: var(--color-link);
  }

  .site-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .site-menu li + li {
    margin-top: var(--space-3);
  }

  .site-menu a {
    font-family: var(--font-heading);
    font-weight: var(--fw-heading);
    font-size: var(--fs-menu);
    line-height: var(--lh-menu);
  }

  .site-menu [aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-menu__contact {
    text-align: center;
    margin: 0;
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('site-menu');
  const closeBtn = document.getElementById('nav-close');

  if (toggle && menu && closeBtn) {
    const FOCUSABLE = 'a[href], button:not([disabled])';
    let lastFocused: HTMLElement | null = null;

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      menu.hidden = false;
      requestAnimationFrame(() => menu.classList.add('is-open'));
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    };

    const close = () => {
      menu.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      const done = () => {
        menu.hidden = true;
        menu.removeEventListener('transitionend', done);
      };
      menu.addEventListener('transitionend', done);
      setTimeout(done, 600);
      lastFocused?.focus();
    };

    toggle.addEventListener('click', open);
    closeBtn.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (menu.hidden) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }

      if (e.key === 'Tab') {
        const items = Array.from(menu.querySelectorAll<HTMLElement>(FOCUSABLE));
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
