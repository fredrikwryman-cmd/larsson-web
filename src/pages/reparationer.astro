---
import Base from '../layouts/Base.astro';
import Page from '../components/pages/Repairs.astro';
import { PAGE_PATHS, withBase, type Lang } from '../i18n/config';
import { pageMeta } from '../i18n/meta';
import { t } from '../i18n/ui';
import { faqFor } from '../lib/faq';

const lang: Lang = 'sv';
const faq = await faqFor(lang);
const meta = pageMeta.repairs.sv;
---

<Base
  lang={lang}
  altPath={PAGE_PATHS.repairs.en}
  title={meta.title}
  description={meta.description}
  structuredData={faq}
  ogImageFile="reparation-sitsflatning-i-papperssnore.jpg"
>
  <Page lang={lang} />
</Base>
