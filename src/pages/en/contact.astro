---
import Base from '../../layouts/Base.astro';
import Page from '../../components/pages/ContactPage.astro';
import { PAGE_PATHS, withBase, type Lang } from '../../i18n/config';
import { pageMeta } from '../../i18n/meta';
import { t } from '../../i18n/ui';

const lang: Lang = 'en';
const meta = pageMeta.contact.en;
---

<Base
  lang={lang}
  altPath={PAGE_PATHS.contact.sv}
  title={meta.title}
  description={meta.description}
>
  <Page lang={lang} />
</Base>
