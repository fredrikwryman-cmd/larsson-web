---
import Base from '../../layouts/Base.astro';
import Page from '../../components/pages/Thanks.astro';
import { PAGE_PATHS, withBase, type Lang } from '../../i18n/config';
import { pageMeta } from '../../i18n/meta';
import { t } from '../../i18n/ui';

const lang: Lang = 'en';
const meta = pageMeta.thanks.en;
const breadcrumbs = [{ label: t(lang).nav.contact, href: withBase(PAGE_PATHS.contact[lang]) }];
---

<Base
  lang={lang}
  altPath={PAGE_PATHS.thanks.sv}
  title={meta.title}
  description={meta.description}
  breadcrumbs={breadcrumbs}
>
  <Page lang={lang} />
</Base>
