---
import Base from '../../layouts/Base.astro';
import Page from '../../components/pages/About.astro';
import { PAGE_PATHS, withBase, type Lang } from '../../i18n/config';
import { pageMeta } from '../../i18n/meta';
import { t } from '../../i18n/ui';

const lang: Lang = 'en';
const meta = pageMeta.about.en;
---

<Base
  lang={lang}
  altPath={PAGE_PATHS.about.sv}
  title={meta.title}
  description={meta.description}
  ogImageFile="verkstad-rottingstav-varms-med-gaslaga.jpg"
>
  <Page lang={lang} />
</Base>
