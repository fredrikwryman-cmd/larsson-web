---
import Base from '../../layouts/Base.astro';
import CasePage from '../../components/CasePage.astro';
import { PAGE_PATHS, withBase, type Lang } from '../../i18n/config';
import { pageMeta } from '../../i18n/meta';
import { t } from '../../i18n/ui';

const lang: Lang = 'en';
const meta = pageMeta.akes.en;
const breadcrumbs = [
  { label: t(lang).nav.commissions, href: withBase(PAGE_PATHS.commissions[lang]) },
];
---

<Base
  lang={lang}
  altPath={PAGE_PATHS.akes.sv}
  title={meta.title}
  description={meta.description}
  ogImageFile="akes_csa.jpg"
  breadcrumbs={breadcrumbs}
>
  {/*
    Upgraded from http:// to https://. The client's page links over http; the
    server redirects to https anyway (checked 2026-09-06), so linking straight
    there spares the visitor an insecure hop. The http form is left verbatim in
    src/data/page-content.json.
  */}
  <CasePage slug="akes" externalHref="https://www.carinasethandersson.com/" lang={lang} />
</Base>
