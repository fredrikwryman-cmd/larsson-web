---
import Base from '../../layouts/Base.astro';
import Page from '../../components/pages/PressPage.astro';
import { PAGE_PATHS, withBase, type Lang } from '../../i18n/config';
import { pageMeta } from '../../i18n/meta';
import { t } from '../../i18n/ui';

const lang: Lang = 'en';
const meta = pageMeta.press.en;
---

<Base
  lang={lang}
  altPath={PAGE_PATHS.press.sv}
  title={meta.title}
  description={meta.description}
  ogImageFile="korgmakare-erica-larsson-i-verkstaden.jpg"
>
  <Page lang={lang} />
</Base>
