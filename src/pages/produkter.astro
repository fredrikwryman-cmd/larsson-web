---
import Base from '../layouts/Base.astro';
import Page from '../components/pages/Products.astro';
import { PAGE_PATHS, withBase, type Lang } from '../i18n/config';
import { pageMeta } from '../i18n/meta';
import { t } from '../i18n/ui';

const lang: Lang = 'sv';
const meta = pageMeta.products.sv;
---

<Base
  lang={lang}
  altPath={PAGE_PATHS.products.en}
  title={meta.title}
  description={meta.description}
  ogImageFile="badhusstolen-230-rottingfatolj-john-larsson.jpg"
>
  <Page lang={lang} />
</Base>
